# === RAISE LAB EQUIPMENT — 301 REDIRECT MAP ===
# Place ABOVE the '# BEGIN WordPress' block

RewriteEngine On

# ── Homepage ──────────────────────────────────────────────────
RewriteRule ^$ https://www.raiselabequip.com/ [R=301,L]

# ── Product Category Pages ────────────────────────────────────
RewriteRule ^category/tablet-hardness-tester/?$ /products/category/hardness-testing [R=301,L]
RewriteRule ^category/tablet-friability-tester/?$ /products/category/friability-testing [R=301,L]
RewriteRule ^category/disintegration-tester/?$ /products/category/disintegration-testing [R=301,L]
RewriteRule ^category/dissolution-tester/?$ /products/category/dissolution-testing [R=301,L]
RewriteRule ^category/powder-testing/?$ /products/category/powder-testing [R=301,L]
RewriteRule ^category/leak-test-apparatus/?$ /products/category/packaging-integrity [R=301,L]
RewriteRule ^category/lacquer-porosity-tester/?$ /products/category/lacquer-porosity-testing [R=301,L]
RewriteRule ^category/analytical-instruments/?$ /products/category/analytical-instruments [R=301,L]

# ── Individual Product Pages ──────────────────────────────────
# Redirect short IDs to descriptive slugs
RewriteRule ^products/rht-3b/?$ /products/tablet-hardness-tester-rht-3b [R=301,L]
RewriteRule ^products/rpht-1p/?$ /products/manual-hardness-tester-rpht-1p [R=301,L]
